# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---- MongoDB: PRIMARY connection ----
# Jesty's own operational data: Contact, Conversation, Message, Group, Tag,
# Attribute, DeviceToken, UserSession (local login mirror).
MONGO_URI=mongodb://127.0.0.1:27017/jesty

# ---- MongoDB: SECOND ("auth", shared) connection ----
# Jesty owns login itself now instead of proxying to another service, and
# reads/writes the SAME Users + IntegrationCredential collections your other
# services already use. Point this at that shared database. If left unset it
# falls back to MONGO_URI (fine for local single-DB dev, not for prod).
AUTH_MONGO_URI=mongodb://127.0.0.1:27017/jesty

# ---- Meta / WhatsApp Cloud API (Official App) ----
WHATSAPP_API_VERSION=v20.0
# These three are now OPTIONAL. A per-user WhatsApp number is normally
# connected via POST /api/integrations/whatsapp (see models/Integration.ts)
# and that number's own accessToken/phoneNumberId is used automatically.
# Kept here only as a single-tenant fallback for local dev / back-compat
# before any Integration has been connected.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WINDOW_HOURS=24

# ---- Auth (owned locally now) ----
# POST /api/auth/login checks email+password directly against the User model
# on the second/shared Mongo connection (bcrypt-hashed, see models/User.ts).
# Jesty then mints its own JWTs — nothing is proxied to another service.
JWT_ACCESS_SECRET=change_this_access_token_signing_secret
JWT_REFRESH_SECRET=change_this_refresh_token_signing_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key used to encrypt/decrypt secret fields on the Integration
# model (WhatsApp access tokens, app secrets, and any other channel's
# credentials — see utils/crypto.ts). Use the SAME value your other
# service(s) use so everyone can read the same encrypted documents. Accepts
# a 64-char hex string, or any passphrase (hashed down to 32 bytes).
ENCRYPTION_KEY=change_this_32_byte_encryption_key

# Static service-to-service token required (via the `jesty-backend-service-token`
# header) on Jesty's media endpoints: POST /api/messages/upload and
# POST /api/profile/picture. See middleware/auth.ts#requireServiceToken.
JESTY_BACKEND_SERVICE_TOKEN=change_this_service_token

# ---- Webhook forwarding ----
# Your other service receives the real Meta webhook (it owns the verify-token
# handshake with Meta) and forwards the same payload to POST /api/webhook
# here, sending this value as the `x-webhook-secret` header. Set the SAME
# value on both sides.
INTERNAL_WEBHOOK_SECRET=change_this_shared_secret

# ---- Firebase Cloud Messaging (push notifications when an agent is offline) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
